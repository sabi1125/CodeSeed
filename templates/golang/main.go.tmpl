package main

import (
	"net/http"

	"${module}/internal/log"

	"github.com/labstack/echo/v4"
)

func main() {
	logger.Init()
	defer logger.Sync()

	// Create an Echo instance
	e := echo.New()

	// Define a route
	e.GET("/", func(c echo.Context) error {
		return c.String(http.StatusOK, "Hello, Echo!")
	})

	// Start the server
	logger.Info("starting server")
	e.Logger.Fatal(e.Start(":8080"))
}
